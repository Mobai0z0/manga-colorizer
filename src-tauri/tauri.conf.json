{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manga Colorizer",
  "version": "0.3.0",
  "identifier": "com.mangacolorizer.app",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Manga Colorizer",
        "url": "app-ui.html",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.ico"],
    "resources": ["resources/weights-manifest.json"],
    "externalBin": ["binaries/manga-colorizer-sidecar"],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}



